# Set this to the deployed FlowPay API base URL.
# Leave empty for same-origin hosting; local dev needs the API URL.
VITE_API_BASE_URL=https://flowpay-backend-qz79.onrender.com

# Storyblok public Content Delivery API token (published content only).
# This token is intentionally public/read-only and is used by the browser.
VITE_STORYBLOK_DELIVERY_API_TOKEN=
# Storyblok Space region: eu, us, ap, ca, or cn.
VITE_STORYBLOK_REGION=eu
