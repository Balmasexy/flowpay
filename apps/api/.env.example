# FlowPay API — server-side environment only
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_JWKS_URL=https://YOUR-NEON-AUTH-JWKS-URL
NEON_AUTH_ISSUER=https://YOUR-NEON-AUTH-ISSUER
NEON_AUTH_AUDIENCE=YOUR-NEON-AUTH-AUDIENCE
WEB_ORIGIN=https://YOUR-FLOWPAY-FRONTEND
PORT=3000

# Paystack server-side deposits and bank-account lookup
PAYSTACK_ENVIRONMENT=test
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_with_test_secret
PAYSTACK_LIVE_SECRET_KEY=
# Keep false until Live activation is explicitly approved.
PAYSTACK_LIVE_ENABLED=false
PAYSTACK_CALLBACK_URL=https://YOUR-FLOWPAY-FRONTEND/payment-return/paystack
PAYSTACK_DEPOSIT_MIN_MINOR=10000
PAYSTACK_DEPOSIT_MAX_MINOR=50000000

# Legacy Test-only fallback during key migration.
# PAYSTACK_SECRET_KEY=sk_test_replace_with_test_secret

# Payouts and dedicated virtual-account requests remain isolated behind
# their existing development-only and explicit feature switches.
FLOWPAY_RUNTIME_ENV=development
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_DEDICATED_ACCOUNTS_ENABLED=false
